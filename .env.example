# SnappFood Commercial QA Portal - Environment Configuration

# SQLite local development (default)
DATABASE_URL="file:./dev.db"

# Microsoft SQL Server production example:
# DATABASE_URL="sqlserver://localhost:1433;database=snappfood_qa;user=sa;password=YourPassword;encrypt=true;trustServerCertificate=true"

# GEMINI_API_KEY: Injected by AI Studio if AI features are used
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Host URL
APP_URL="MY_APP_URL"
