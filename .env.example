# Local development database; Prisma paths are relative to prisma/schema.prisma.
DATABASE_URL="file:./dev.db"
# Exact public browser origin. Production requires HTTPS.
APP_URL="http://localhost:3000"
# Replace both with independent random strings of at least 32 characters for production.
SESSION_SECRET=""
COOKIE_SECRET=""
AUTH_PROVIDER="local"
# Configure only the actual reverse proxy IP/CIDR list, e.g. loopback.
# TRUST_PROXY="loopback"
# Demo seeding is allowed only outside production and on an empty database.
# DEMO_SEED="true"
# DEV_ROLE_SWITCH="false"
