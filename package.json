{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server.ts",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:switch:sqlserver": "node scripts/switch-db.js sqlserver",
    "db:switch:sqlite": "node scripts/switch-db.js sqlite",
    "db:migrate:check-date": "tsx scripts/migrate-check-date.ts",
    "test:db:setup": "DATABASE_URL=\"file:./test.db\" prisma db push --skip-generate && DATABASE_URL=\"file:./test.db\" tsx prisma/seed.ts",
    "test": "npm run test:db:setup && NODE_ENV=test TEST_DATABASE_URL=\"file:./test.db\" tsx --test src/integration.test.ts src/api.test.ts src/utils/trendMetrics.test.ts src/utils/scoring.test.ts",
    "test:rbac": "npm run test:db:setup && NODE_ENV=test TEST_DATABASE_URL=\"file:./test.db\" tsx --test src/integration.test.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fontsource/vazirmatn": "5.3.0",
    "@google/genai": "2.4.0",
    "@prisma/client": "6.4.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/bcryptjs": "3.0.0",
    "@types/cookie-parser": "1.4.10",
    "@vitejs/plugin-react": "6.1.1",
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "dotenv": "17.2.3",
    "express": "4.21.2",
    "lucide-react": "0.546.0",
    "motion": "12.23.24",
    "prisma": "6.4.1",
    "react": "19.0.1",
    "react-dom": "19.0.1",
    "react-is": "19.0.0",
    "recharts": "3.10.1",
    "tsx": "4.23.15",
    "vite": "8.3.0",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "22.14.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.4.21",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
