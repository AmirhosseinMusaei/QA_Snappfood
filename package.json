{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node scripts/start.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "node --import tsx prisma/seed.ts",
    "db:switch:sqlserver": "node scripts/switch-db.js sqlserver",
    "db:switch:sqlite": "node scripts/switch-db.js sqlite",
    "db:migrate:check-date": "tsx scripts/migrate-check-date.ts",
    "test:db:setup": "node scripts/test.mjs --setup-only",
    "test": "node scripts/test.mjs",
    "test:rbac": "node scripts/test.mjs",
    "db:migrate:integrity": "node --import tsx scripts/migrate-integrity.ts --apply",
    "admin:bootstrap": "node --import tsx scripts/bootstrap-admin.ts",
    "test:e2e": "playwright test"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fontsource/vazirmatn": "5.3.0",
    "@google/genai": "2.4.0",
    "@prisma/client": "6.4.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/bcryptjs": "3.0.0",
    "@types/cookie-parser": "1.4.10",
    "@vitejs/plugin-react": "6.1.1",
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "dotenv": "17.2.3",
    "exceljs": "4.4.0",
    "express": "4.22.3",
    "lucide-react": "0.546.0",
    "motion": "12.23.24",
    "prisma": "6.4.1",
    "react": "19.0.1",
    "react-dom": "19.0.1",
    "react-is": "19.0.0",
    "recharts": "3.10.1",
    "tsx": "4.23.15",
    "vite": "8.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/express": "4.17.21",
    "@types/node": "22.14.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.4.21",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.13.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
