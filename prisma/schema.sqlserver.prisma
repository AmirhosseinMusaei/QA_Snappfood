// Prisma Schema for SnappFood Commercial QA Portal (Microsoft SQL Server Production)
// To activate this schema: copy to prisma/schema.prisma or run: npm run db:switch:sqlserver

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  id         String @db.NVarChar(200)      @id @default(cuid())
  username   String @db.NVarChar(200)      @unique
  password   String @db.NVarChar(200)      // bcrypt hash
  name       String @db.NVarChar(200)
  role       String @db.NVarChar(200)      // 'agent' | 'team_lead' | 'manager' | 'qa_controller' | 'qa_supervisor' | 'admin'
  department String? @db.NVarChar(200)     // 'support' | 'sales'
  team       String? @db.NVarChar(200)
  avatar     String? @db.NVarChar(200)
  active     Boolean     @default(true)
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt

  agent_profile       Agent?      @relation("UserToAgent")
  managed_teams       Team[]      @relation("TeamLead")
  supervised_agents   Agent[]     @relation("AgentTeamLead")
  controlled_agents   Agent[]     @relation("AgentController")
}

model Team {
  id         String @db.NVarChar(200)      @id @default(cuid())
  name       String @db.NVarChar(200)      @unique
  department String @db.NVarChar(200)      // 'support' | 'sales'
  lead_name  String @db.NVarChar(200)
  lead_id    String? @db.NVarChar(200)
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt

  lead        User?        @relation("TeamLead", fields: [lead_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  agents      Agent[]
  assessments Assessment[]

  @@index([lead_id])
}

model Agent {
  id                  String @db.NVarChar(200)       @id @default(cuid())
  source_id           String @db.NVarChar(200)       @unique // e.g. "3718"
  name                String @db.NVarChar(200)
  department          String @db.NVarChar(200)       // 'support' | 'sales'
  user_id             String? @db.NVarChar(200)      @unique
  team_id             String @db.NVarChar(200)
  team_name           String @db.NVarChar(200)
  team_lead_id        String? @db.NVarChar(200)
  team_lead           String @db.NVarChar(200)
  controller_id       String? @db.NVarChar(200)
  controller          String @db.NVarChar(200)
  operator_panel      String? @db.NVarChar(200)      // 'CRM Sales' | 'Ring' | 'VOIP' | 'Jira'
  sample_name         String? @db.NVarChar(200)      @default("Random Sampling") // 'Support group' | 'bi-party' | 'Dislike' | 'Random Sampling'
  check_process       String? @db.NVarChar(200)      @default("if needed")       // 'if needed' | 'mandatory'
  min_monthly_reviews Int          @default(40)
  avatar              String? @db.NVarChar(200)
  active              Boolean      @default(true)
  created_at          DateTime     @default(now())
  updated_at          DateTime     @updatedAt

  user                User?        @relation("UserToAgent", fields: [user_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  team                Team         @relation(fields: [team_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  team_lead_user      User?        @relation("AgentTeamLead", fields: [team_lead_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  controller_user     User?        @relation("AgentController", fields: [controller_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  assessments         Assessment[]

  @@index([source_id])
  @@index([team_id])
  @@index([user_id])
  @@index([team_lead_id])
  @@index([controller_id])
}

model AssessmentForm {
  id          String @db.NVarChar(200)         @id @default(cuid())
  form_type   String @db.NVarChar(200)         // 'support' | 'sales'
  title       String @db.NVarChar(200)
  version     Int            @default(1)
  is_active   Boolean        @default(true)
  created_at  DateTime       @default(now())
  updated_at  DateTime       @updatedAt

  criteria    RubricCriteria[]
  assessments Assessment[]

  @@unique([form_type, version])
}

model RubricCriteria {
  id          String @db.NVarChar(200)               @id @default(cuid())
  form_id     String @db.NVarChar(200)
  section     String @db.NVarChar(200)               // e.g. 'soft_skill' | 'knowledge' | 'script' | 'mistake'
  title       String @db.NVarChar(200)
  max_points  Int
  order_index Int                  @default(0)

  form        AssessmentForm       @relation(fields: [form_id], references: [id])
  items       RubricCriteriaItem[]

  @@index([form_id])
}

model RubricCriteriaItem {
  id          String @db.NVarChar(200)         @id @default(cuid())
  criteria_id String @db.NVarChar(200)
  title       String @db.NVarChar(200)
  max_points  Int
  order_index Int            @default(0)

  criteria    RubricCriteria @relation(fields: [criteria_id], references: [id], onDelete: Cascade)

  @@index([criteria_id])
}

model Fault {
  id          String @db.NVarChar(200)       @id @default(cuid())
  title       String @db.NVarChar(200)       @unique
  department  String @db.NVarChar(200)       // 'support' | 'sales' | 'both'
  category    String @db.NVarChar(200)
  is_critical Boolean      @default(false)
  description String? @db.NVarChar(Max)
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt

  assessments Assessment[]
}

model Assessment {
  id                    String @db.NVarChar(200)            @id @default(cuid())
  agent_id              String @db.NVarChar(200)
  controller_id         String @db.NVarChar(200)
  team_id               String? @db.NVarChar(200)
  form_id               String? @db.NVarChar(200)
  form_type             String @db.NVarChar(200)            // 'support' | 'sales'
  form_version          Int?              @default(1)
  sample_name           String @db.NVarChar(200)            // 'Support group' | 'bi-party' | 'Dislike' | 'Random Sampling' | 'if needed'
  vendor_id             String? @db.NVarChar(200)
  vendor_title          String? @db.NVarChar(200)
  check_date            DateTime          @default(now()) // Gregorian UTC DateTime
  fault_id              String? @db.NVarChar(200)
  backend_general       Boolean           @default(false)
  is_fraud              Boolean           @default(false)
  result                String @db.NVarChar(200)            // 'No problem' | 'Need to check' | 'Coaching Required' | 'بررسی شده'
  result_comment        String? @db.NVarChar(Max)

  // Team Lead Review Workflow
  team_lead_reviewed    Boolean           @default(false)
  team_lead_note        String? @db.NVarChar(Max)
  team_lead_reviewed_at String? @db.NVarChar(200)
  action_taken          String? @db.NVarChar(200)           // 'آموزش فردی' | 'فیدبک' | 'بررسی و اصلاح اسکریپت' | 'تحلیل تماس‌ها' | 'اصلاح فرآیند' | 'توضیح اثر خطا'

  // Support Specific Fields
  ticket_number         String? @db.NVarChar(200)
  voice_link            String? @db.NVarChar(200)
  fault_categories      String? @db.NVarChar(Max)           // JSON array string e.g. '["Vendor problem"]'
  support_scores_json   String? @db.NVarChar(Max)           // JSON object e.g. '{"intro": 5, "courtesy": 5}'
  description           String? @db.NVarChar(Max)

  // Sales Specific Fields
  phone_number          String? @db.NVarChar(200)
  project               String? @db.NVarChar(200)           // 'All Project' | 'NCR' | 'Promotion' | 'Campaign' | 'Bi-Party'
  discount_or_coupon    String? @db.NVarChar(200)
  registration_date     String? @db.NVarChar(200)
  execution_date        String? @db.NVarChar(200)
  mistake_count         Int?              @default(0)
  sales_scores_json     String? @db.NVarChar(Max)           // JSON object e.g. '{"greeting": 5, ...}'

  // Scores
  revision              Int               @default(1)
  legacy_aggregate      Boolean           @default(false)
  scoring_policy_json   String? @db.NVarChar(Max)
  fault_is_critical     Boolean?
  idempotency_key       String? @db.NVarChar(200)
  request_hash          String? @db.NVarChar(200)
  total_score           Int
  created_at            DateTime          @default(now())
  updated_at            DateTime          @updatedAt
  deleted_at            DateTime?         // Soft delete

  agent                 Agent             @relation(fields: [agent_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  team                  Team?             @relation(fields: [team_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  form                  AssessmentForm?   @relation(fields: [form_id], references: [id])
  fault                 Fault?            @relation(fields: [fault_id], references: [id])
  scores                AssessmentScore[]
  disputes              Dispute[]

  @@index([idempotency_key])
  @@index([agent_id])
  @@index([check_date])
  @@index([team_id])
  @@index([result])
  @@index([controller_id])
  @@index([deleted_at])
}

model AssessmentScore {
  id            String @db.NVarChar(200)     @id @default(cuid())
  assessment_id String @db.NVarChar(200)
  item_id       String @db.NVarChar(200)     // Reference to RubricCriteriaItem id
  criterion_id  String? @db.NVarChar(200)
  awarded_score Int
  max_score     Int

  assessment    Assessment @relation(fields: [assessment_id], references: [id], onDelete: Cascade)

  @@index([assessment_id])
  @@index([item_id])
}

model Dispute {
  id                 String @db.NVarChar(200)     @id @default(cuid())
  assessment_id      String @db.NVarChar(200)
  agent_id           String @db.NVarChar(200)
  agent_name         String @db.NVarChar(200)
  criterion_id       String? @db.NVarChar(200)
  criterion_title    String? @db.NVarChar(200)
  agent_comment      String @db.NVarChar(Max)
  status             String @db.NVarChar(200)     @default("open") // 'pending' | 'resolved' | 'rejected'
  controller_id      String? @db.NVarChar(200)
  controller_comment String? @db.NVarChar(Max)
  original_score     Int
  revised_score      Int?
  created_at         DateTime   @default(now())
  resolved_at        DateTime?

  assessment         Assessment @relation(fields: [assessment_id], references: [id], onDelete: Cascade)

  @@index([assessment_id])
  @@index([status])
  @@index([agent_id])
}

model AuditLog {
  id         String @db.NVarChar(200)   @id @default(cuid())
  user_id    String @db.NVarChar(200)
  user_name  String @db.NVarChar(200)
  user_role  String @db.NVarChar(200)
  entity     String @db.NVarChar(200)   // 'assessment' | 'dispute' | 'agent' | 'rubric' | 'fault' | 'settings' | 'problem'
  entity_id  String @db.NVarChar(200)
  action     String @db.NVarChar(200)   // 'create' | 'update' | 'delete' | 'dispute_filed' | 'dispute_resolved' | 'team_lead_reviewed' | 'rubric_updated' | 'settings_updated'
  field      String? @db.NVarChar(200)
  old_value  String? @db.NVarChar(Max)
  new_value  String? @db.NVarChar(Max)
  created_at DateTime @default(now())

  @@index([entity])
  @@index([entity_id])
  @@index([created_at])
  @@index([user_id])
}

model Setting {
  key         String @db.NVarChar(200)   @id
  value       String @db.NVarChar(Max)   // JSON string
  description String? @db.NVarChar(Max)
  updated_at  DateTime @updatedAt
}

model Problem {
  id            String @db.NVarChar(200)    @id @default(cuid())
  priority      String @db.NVarChar(200)    // 'High' | 'Medium' | 'Low' | 'Critical'
  issue_date    String @db.NVarChar(200)    // Jalali date e.g. "۱۴۰۳/۰۷/۱۰"
  team          String @db.NVarChar(200)
  category      String @db.NVarChar(200)
  title         String @db.NVarChar(200)
  description   String @db.NVarChar(Max)
  status        String @db.NVarChar(200)    @default("Pending") // 'Pending' | 'Resolved'
  owner         String @db.NVarChar(200)
  resolved_at   String? @db.NVarChar(200)
  solution_note String? @db.NVarChar(Max)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  @@index([team])
  @@index([status])
}

// Opaque server-side sessions: revocation is durable and shared across workers.
model Session {
  token_hash String @db.NVarChar(200) @id
  user_id String @db.NVarChar(200)
  expires_at DateTime
  created_at DateTime @default(now())
  @@index([user_id])
  @@index([expires_at])
}
